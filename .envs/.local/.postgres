# Postgres 18+ images default PGDATA to /var/lib/postgresql/<major>/docker and
# refuse to start if something is mounted at the legacy /var/lib/postgresql/data
# path without being told to use it. Pin PGDATA explicitly since the compose
# volume is mounted at that legacy path.
PGDATA=/var/lib/postgresql/data
